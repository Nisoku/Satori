{
  "name": "@nisoku/satori-log",
  "version": "0.1.1",
  "description": "Event-centric observability layer for complex apps.",
  "main": "./dist/satori.js",
  "module": "./dist/satori.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/satori.js",
      "require": "./dist/satori.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nisoku/Satori.git"
  },
  "author": "Nisoku",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nisoku/Satori/issues"
  },
  "homepage": "https://github.com/Nisoku/Satori#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  }
}
