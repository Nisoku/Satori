{
  "name": "@nisoku/satori",
  "version": "0.1.4",
  "description": "Event-centric observability layer for complex apps.",
  "main": "./dist/satori.js",
  "module": "./dist/satori.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/satori.mjs",
      "require": "./dist/satori.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "make-pretty": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md,html,cjs}'",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nisoku/Satori.git"
  },
  "author": "Nisoku",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nisoku/Satori/issues"
  },
  "homepage": "https://github.com/Nisoku/Satori#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.6.0",
    "jest": "^30.2.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.16"
  }
}
