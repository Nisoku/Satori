{
  "name": "satori",
  "version": "0.1.0",
  "description": "Event-centric observability layer for complex apps.",
  "main": "./dist/satori.cjs.js",
  "module": "./dist/satori.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/satori.es.js",
      "require": "./dist/satori.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NellowTCS/Satori.git"
  },
  "author": "NellowTCS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NellowTCS/Satori/issues"
  },
  "homepage": "https://github.com/NellowTCS/Satori#readme",
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  }
}
